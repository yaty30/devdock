{
  "name": "devdock",
  "version": "1.1.4",
  "description": "DevDock.",
  "main": "build/main/index.js",
  "productName": "DevDock",
  "author": "yaty",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "test:ui": "npm run build && playwright test",
    "preview": "node scripts/p`review.cjs",
    "start": "node scripts/start.cjs",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "rebuild": "electron-rebuild -f -w better-sqlite3 -w oracledb",
    "rebuild:native": "npm rebuild better-sqlite3 oracledb node-pty --runtime=electron --target=33.4.11 --dist-url=https://electronjs.org/headers"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@lezer/highlight": "^1.2.3",
    "@lucide/lab": "^0.1.2",
    "@tanstack/react-virtual": "^3.13.24",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-character-count": "^3.22.5",
    "@tiptap/extension-color": "^3.22.5",
    "@tiptap/extension-highlight": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-text-style": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "better-sqlite3": "^12.9.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.505.0",
    "mysql2": "^3.22.3",
    "node-pty": "^1.1.0",
    "oracledb": "^6.10.0",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "ws": "^8.20.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.60.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^33.2.1",
    "electron-rebuild": "^3.2.9",
    "electron-squirrel-startup": "^1.0.1",
