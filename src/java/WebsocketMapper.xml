<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ivs.dashboard.chat.WebsocketMapper">

    <resultMap id="ChatMessageResultMap" type="com.ivs.dashboard.chat.ChatSocket$ChatMessage">
        <id     property="id"                column="id"/>
        <result property="conversationId"    column="conversation_id"/>
        <result property="senderUserId"      column="sender_user_id"/>
        <result property="senderDisplayName" column="sender_display_name"/>
        <result property="body"              column="body"/>
        <result property="createdAt"         column="created_at"/>
    </resultMap>

    <insert id="insertMessage" parameterType="com.ivs.dashboard.chat.ChatSocket$ChatMessage">
        INSERT INTO log_ws_message (
            id,
            conversation_id,
            sender_user_id,
            sender_display_name,
            body,
            created_at
        ) VALUES (
            #{id},
            #{conversationId},
            #{senderUserId},
            #{senderDisplayName},
            #{body},
            #{createdAt}
        )
    </insert>

    <select id="selectMessagesByConversationId" resultMap="ChatMessageResultMap">
        SELECT *
        FROM log_ws_message
        WHERE conversation_id = #{conversationId}
        ORDER BY created_at ASC
        LIMIT #{limit}
    </select>

</mapper>